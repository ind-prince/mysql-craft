{
  "name": "mysql-craft",
  "version": "1.2.0",
  "description": "Modern, lightweight, developer-friendly MySQL wrapper for Node.js & TypeScript with built-in security, transactions, and modern logging.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js",
      "require": "./dist/security/index.cjs"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js",
      "require": "./dist/middleware/index.cjs"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js",
      "require": "./dist/errors/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "keywords": [
    "mysql",
    "mysql2",
    "typescript",
    "database",
    "wrapper",
    "transactions",
    "security",
    "jwt",
    "sql-injection-prevention",
    "tree-shaking",
    "zero-overhead"
  ],
  "author": {
    "name": "Prince Kumar",
    "email": "Princekashyapsingh@gmail.com",
    "url": "https://github.com/ind-prince"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ind-prince/mysql-craft.git"
  },
  "homepage": "https://ind-prince.github.io/docs.mysql-craft/",
  "bugs": {
    "url": "https://github.com/ind-prince/mysql-craft/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "aws-ssl-profiles": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "aws-ssl-profiles": {
      "optional": true
    }
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "aws-ssl-profiles": "^1.1.2",
    "express": "^4.21.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "side-channel": "^1.1.0",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}