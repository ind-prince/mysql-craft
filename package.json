{
  "name": "mysql-craft",
  "version": "1.0.4",
  "description": "Modern, lightweight, developer-friendly MySQL wrapper for Node.js & TypeScript with built-in security, transactions, and modern logging.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "default": "./dist/security/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "default": "./dist/middleware/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "tsc -p tsconfig.build.json -w",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "keywords": [
    "mysql",
    "mysql2",
    "typescript",
    "database",
    "wrapper",
    "transactions",
    "security",
    "jwt",
    "bcrypt",
    "sql-injection-prevention"
  ],
  "author": {
    "name": "Prince Kumar",
    "email": "Princekashyapsingh@gmail.com",
    "url": "https://github.com/ind-prince"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ind-prince/mysql-craft.git"
  },
  "homepage": "https://ind-prince.github.io/docs.mysql-craft/",
  "bugs": {
    "url": "https://github.com/ind-prince/mysql-craft/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "express": "^4.21.1",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}